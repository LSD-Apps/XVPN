// Microsoft Visual C++ generated resource script.
//
#pragma code_page(65001)
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
/////////////////////////////////////////////////////////////////////////////
//
// Generated from the TEXTINCLUDE 2 resource.
//
#include "winres.h"

/////////////////////////////////////////////////////////////////////////////
#undef APSTUDIO_READONLY_SYMBOLS

/////////////////////////////////////////////////////////////////////////////
// Chinese (Simplified) resources
//
// 资源语言跟着产品走：源文件里仅有图标与版本信息两项，而版本信息的字符串
// 明确标了 zh-CN（见下方 StringFileInfo 的块名），此处保持一致。
// 外层守卫仍按 Flutter 模板的 AFX_TARG_ENU 保留：它只在以 AFX_RESOURCE_DLL
// 方式构建资源 DLL 时才起作用，本项目不走那条路。

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

#ifdef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE
//

1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include ""winres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END

#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 键名 <语言><代码页>：zh-CN（0x0804）+ Unicode（1200 = 0x04B0）。
        //
        // **代码页不能写 1252**：那套 8 位块塞不下「幽门」，rc.exe 会把它降级成
        // 问号，于是 exe 属性里显示的是「??」。写 1200 让 rc 按 UTF-16 存，
        // 中英文都原样保留。文件头已有 `#pragma code_page(65001)`，
        // 源码本身按 UTF-8 读，两者配合才不会出现乱码。
        BLOCK "080404b0"
        BEGIN
            // 作者（发行者）。用户可见的「谁做的」以这里为准。
            VALUE "CompanyName", "LUSIDA" "\0"
            // 任务管理器「描述」列显示它，所以是产品名而不是文件名。
            VALUE "FileDescription", "幽门" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            // InternalName / OriginalFilename 刻意保持 ASCII 的 "xvpn"：
            // 它们是**可执行文件名**，跟着 windows/CMakeLists.txt 的
            // BINARY_NAME 走，与显示名无关。改这里不会改文件名，只会让
            // 排查崩溃转储的人对不上号。
            VALUE "InternalName", "xvpn" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 LUSIDA. All rights reserved." "\0"
            VALUE "OriginalFilename", "xvpn.exe" "\0"
            VALUE "ProductName", "幽门" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
            VALUE "Comments", "https://www.lusida.net" "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

#endif    // Chinese (Simplified) resources
